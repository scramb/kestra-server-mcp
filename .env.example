# Entra ID (Azure AD) OAuth 2.1
ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here

# Kestra API
KESTRA_API_URL=http://localhost:8080/api/v1
KESTRA_API_TOKEN=your-kestra-api-token

# MCP Transport: "sse" for remote HTTPS, "stdio" for local
KESTRA_MCP_TRANSPORT=sse
KESTRA_MCP_HOST=127.0.0.1
KESTRA_MCP_PORT=8081

# OAuth callback URL (must match Entra app registration redirect URI)
MCP_REDIRECT_URI=http://127.0.0.1:8081/oauth/callback
