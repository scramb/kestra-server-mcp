# OIDC authentication (generic — Entra, Google, Okta, Keycloak, etc.)
# These are the MCP server's OWN credentials registered with the identity provider.
# The server acts as an OAuth Authorization Server, proxying user login to the IdP.
# Preferred: use OIDC_* vars
OIDC_ISSUER_URL=https://your-provider.example.com
OIDC_CLIENT_ID=your-client-id-here
OIDC_CLIENT_SECRET=your-client-secret-here
# OIDC_REDIRECT_URI=http://localhost:8081/oauth/entra-callback
# OIDC scopes to request from the identity provider (space-separated)
OIDC_SCOPES=openid profile
# Optional overrides (usually auto-detected):
# OIDC_AUTHORITY=https://your-provider.example.com
# OIDC_JWKS_URI=https://your-provider.example.com/discovery/keys

# Backward compatible: ENTRA_* vars also work (auto-mapped to OIDC_*)
# ENTRA_TENANT_ID=your-tenant-id-here
# ENTRA_CLIENT_ID=your-client-id-here
# ENTRA_CLIENT_SECRET=your-client-secret-here

# Kestra API
KESTRA_API_URL=http://localhost:8080/api/v1
KESTRA_TENANT=main
KESTRA_VERIFY_SSL=true

# Fernet encryption key (generate with: uv run kestra-mcp generate-key)
# Also used as the HMAC key for self-signed OAuth access tokens
ENCRYPTION_KEY=your-encryption-key-here

# MCP Transport: "http" for Streamable HTTP (remote), "stdio" for local
KESTRA_MCP_TRANSPORT=http
KESTRA_MCP_HOST=localhost
KESTRA_MCP_PORT=8081

# OAuth Authorization Server settings
# AUTH_SERVER_ISSUER_URL=http://localhost:8081
# ACCESS_TOKEN_TTL_SECONDS=3600
