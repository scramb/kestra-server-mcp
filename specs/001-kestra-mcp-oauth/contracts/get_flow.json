{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "get_flow",
  "description": "Retrieves a single flow including its YAML source. Requires kestra.flow.read role.",
  "permissions": {
    "required_roles": ["kestra.flow.read"],
    "visible_when": "user has kestra.flow.read role"
  },
  "input": {
    "type": "object",
    "properties": {
      "namespace": {
        "type": "string",
        "description": "Flow namespace"
      },
      "flow_id": {
        "type": "string",
        "description": "Flow ID"
      }
    },
    "required": ["namespace", "flow_id"]
  },
  "output": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "description": "Flow ID" },
      "namespace": { "type": "string", "description": "Flow namespace" },
      "revision": { "type": "integer", "description": "Current revision" },
      "disabled": { "type": "boolean", "description": "Whether flow is disabled" },
      "deleted": { "type": "boolean", "description": "Whether flow is soft-deleted" },
      "source": { "type": "string", "description": "Flow definition YAML" },
      "tasks": { "type": "array", "description": "Parsed task definitions" }
    },
    "required": ["id", "namespace", "source"]
  },
  "error_codes": [
    {
      "code": "UNAUTHENTICATED",
      "reason": "No valid session or token expired beyond silent refresh"
    },
    {
      "code": "INSUFFICIENT_PERMISSION",
      "reason": "User lacks kestra.flow.read role"
    },
    {
      "code": "NOT_FOUND",
      "reason": "Flow with given namespace/id does not exist"
    },
    {
      "code": "UPSTREAM_ERROR",
      "reason": "Kestra API responded with error (status code mapped)"
    }
  ],
  "kestra_api": {
    "method": "GET",
    "path": "/api/v1/flows/{namespace}/{flow_id}",
    "query_params": [],
    "auth_header": "Bearer {kestra_api_token}"
  }
}
